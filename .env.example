# The site to audit. Required.
SITE_URL=https://thesickestpodcast.com

# Maximum number of concurrent page requests.
MAX_CONCURRENCY=5

# Per-request timeout in milliseconds.
REQUEST_TIMEOUT=10000

# Delay (ms) between requests within a single worker, to avoid hammering the target.
REQUEST_DELAY_MS=250

# Custom User-Agent string sent with every request.
USER_AGENT=SEOWatchdogBot/0.1 (+https://github.com/your-org/seo-watchdog)

# Maximum number of pages to crawl in a single run (safety cap). 0 = no cap.
MAX_PAGES=0

# Whether to discover additional internal pages by following links found
# while crawling, beyond what's listed in the sitemap.
DISCOVER_INTERNAL_URLS=true

# Safety cap on how many *additional* pages (not in the sitemap) discovery
# is allowed to crawl in a single run.
MAX_DISCOVERED_PAGES=100

# How many link-hops beyond the sitemap seed pages discovery is allowed to follow.
MAX_CRAWL_DEPTH=3

# --- Supabase persistence (optional) ---
# Set PERSIST_RESULTS=true to store each crawl in Supabase for historical
# comparison. When false/unset, the audit still writes output/latest-crawl.json
# but no history is kept and no comparison is produced.
PERSIST_RESULTS=false

# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Service role key. Server-side / CLI use ONLY. Never expose this in any
# frontend or browser-loaded code — the dashboard server reads it directly
# from the environment and never sends it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Port the local read-only dashboard server listens on.
DASHBOARD_PORT=4173
